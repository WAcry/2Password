<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>2Password</AssemblyName>
    <RootNamespace>TwoPassword.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.0</Version>
    <Description>2Password · Independent keys. One secure package.</Description>
    <Product>2Password</Product>
    <Company>2Password</Company>
    <Copyright>Copyright © 2026 David Ziyuan Zhang</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>zh-CN;zh-Hans;en</SatelliteResourceLanguages>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TwoPassword.Core/TwoPassword.Core.csproj" />
    <ProjectReference Include="../TwoPassword.Recovery/TwoPassword.Recovery.csproj" />
    <ProjectReference Include="../TwoPassword.Localization/TwoPassword.Localization.csproj" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.txt" LogicalName="TwoPassword.ThirdPartyNotices.txt" />
  </ItemGroup>
</Project>
