<Window x:Class="TwoPassword.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:TwoPassword.App"
        Title="2Password" Width="680" Height="620" MinWidth="520" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp" PreviewTextInput="Window_PreviewTextInput"
        Activated="Window_Activated" StateChanged="Window_StateChanged" SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource BarButton}" Content="&#xE72B;" Margin="6,0,0,0" Visibility="Collapsed" Click="Back_Click"
                        ToolTip="{DynamicResource Ui.Back}" AutomationProperties.Name="{DynamicResource Ui.Back}" AutomationProperties.AutomationId="Back"/>
                <TextBlock x:Name="WindowCaption" Text="2Password" Foreground="{DynamicResource Ink3}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource BarButton}" Margin="0,4,0,0" Click="GitHub_Click"
                        ToolTip="GitHub" AutomationProperties.Name="GitHub" AutomationProperties.AutomationId="GitHub">
                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                </Button>
                <Button x:Name="MenuButton" Style="{StaticResource BarButton}" Content="&#xE712;" Margin="0,4,4,0" Click="Menu_Click"
                        ToolTip="{DynamicResource Ui.More}" AutomationProperties.Name="{DynamicResource Ui.More}" AutomationProperties.AutomationId="Menu"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="{DynamicResource Ui.Minimize}"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" AutomationProperties.Name="{DynamicResource Ui.Maximize}"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="{DynamicResource Ui.Close}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <!-- Home: one place to drop anything -->
            <Grid x:Name="HomeView" Margin="28,4,28,28">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Rectangle x:Name="DropFill" RadiusX="18" RadiusY="18" Fill="Transparent"/>
                    <Rectangle x:Name="DropOutline" RadiusX="18" RadiusY="18" Stroke="{DynamicResource LineStrong}" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <ContentControl x:Name="HomeLock" Template="{StaticResource LockGlyph}" Width="60" Height="60" Foreground="{DynamicResource Ink}" Focusable="False" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DropTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,18,0,0" TextOptions.TextFormattingMode="Ideal"/>
                        <StackPanel x:Name="DropButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button Content="{DynamicResource Ui.ChooseFile}" Click="ChooseFile_Click" AutomationProperties.AutomationId="ChooseFile"/>
                            <Button Content="{DynamicResource Ui.ChooseFolder}" Click="ChooseFolder_Click" Margin="8,0,0,0" AutomationProperties.AutomationId="ChooseFolder"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,18,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="HomeNotice" Foreground="{DynamicResource Danger}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource Ui.OpenPackage}" HorizontalAlignment="Center" Click="OpenPackage_Click" AutomationProperties.AutomationId="OpenPackage"/>
                </StackPanel>
            </Grid>

            <!-- Encrypt -->
            <Grid x:Name="EncryptView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel MaxWidth="520" Margin="28,6,28,16">
                        <Border Style="{StaticResource Tile}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource Sunken}">
                                    <TextBlock x:Name="SourceGlyph" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SourceName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SourceMeta" Style="{StaticResource Meta}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text=" "/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="SourceList" MaxHeight="144" Margin="2,8,2,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <StackPanel x:Name="SourceItems"/>
                        </ScrollViewer>
                        <WrapPanel Margin="2,10,2,0">
                            <Button Style="{StaticResource LinkButton}" Content="{DynamicResource Ui.AddFiles}" Click="ChooseFile_Click" AutomationProperties.AutomationId="AddFiles"/>
                            <Button Style="{StaticResource LinkButton}" Content="{DynamicResource Ui.AddFolders}" Margin="16,0,0,0" Click="ChooseFolder_Click" AutomationProperties.AutomationId="AddFolders"/>
                        </WrapPanel>

                        <Grid Margin="2,28,2,10">
                            <TextBlock Text="{DynamicResource Ui.Passwords}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PasswordsHint" Text="{DynamicResource Ui.AnyOneOpens}" Style="{StaticResource Meta}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel x:Name="PasswordRows"/>
                        <Grid Margin="2,4,2,0">
                            <Button x:Name="AddPasswordButton" Style="{StaticResource LinkButton}" Content="{DynamicResource Ui.AddPassword}" HorizontalAlignment="Left"
                                    Click="AddPassword_Click" AutomationProperties.AutomationId="AddPassword"/>
                            <TextBlock x:Name="EncryptCapsLock" Text="{DynamicResource Ui.CapsLock}" Style="{StaticResource Meta}" Foreground="{DynamicResource Warning}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>

                        <Border Style="{StaticResource Tile}" Padding="14,0" Height="44" Margin="0,28,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Ui.SaveTo}" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <TextBlock x:Name="OutputPathText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="{DynamicResource Ui.Change}" Margin="14,0,0,0" Click="ChooseOutput_Click" AutomationProperties.AutomationId="ChooseOutput"/>
                            </Grid>
                        </Border>

                        <ToggleButton x:Name="OptionsToggle" Style="{StaticResource Disclosure}" Content="{DynamicResource Ui.Options}" Margin="2,18,0,0"
                                      Checked="OptionsToggle_Changed" Unchecked="OptionsToggle_Changed" AutomationProperties.AutomationId="Options"/>
                        <Grid x:Name="OptionsPanel" Margin="2,14,0,4" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="72"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="10"/><RowDefinition/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource Ui.Compression}" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Border Grid.Column="1" Style="{StaticResource SegmentTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CompressionZstd" Style="{StaticResource Segment}" GroupName="Compression" Content="Zstd (Lv.3)" IsChecked="True"/>
                                    <RadioButton x:Name="CompressionBrotli" Style="{StaticResource Segment}" GroupName="Compression" Content="Brotli (Lv.6)"/>
                                    <RadioButton x:Name="CompressionNone" Style="{StaticResource Segment}" GroupName="Compression" Content="{DynamicResource Ui.NoCompression}" ToolTip="{DynamicResource Ui.NoCompressionTip}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="2" Text="{DynamicResource Ui.Output}" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SegmentTrack}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LayoutAuto" Style="{StaticResource Segment}" GroupName="Layout" Content="{DynamicResource Ui.Auto}" ToolTip="{DynamicResource Ui.AutoTip}" IsChecked="True"/>
                                    <RadioButton x:Name="LayoutEmbedded" Style="{StaticResource Segment}" GroupName="Layout" Content="{DynamicResource Ui.SingleExe}" ToolTip="{DynamicResource Ui.SingleExeTip}"/>
                                    <RadioButton x:Name="LayoutDetached" Style="{StaticResource Segment}" GroupName="Layout" Content="EXE + .2pw" ToolTip="{DynamicResource Ui.DetachedTip}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="4" Text="{DynamicResource Ui.Recovery}" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource SegmentTrack}" ToolTip="{DynamicResource Ui.RecoveryTip}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Recovery0" Style="{StaticResource Segment}" GroupName="Recovery" Content="{DynamicResource Ui.Off}"/>
                                    <RadioButton x:Name="Recovery5" Style="{StaticResource Segment}" GroupName="Recovery" Content="5%" IsChecked="True"/>
                                    <RadioButton x:Name="Recovery10" Style="{StaticResource Segment}" GroupName="Recovery" Content="10%"/>
                                    <RadioButton x:Name="Recovery20" Style="{StaticResource Segment}" GroupName="Recovery" Content="20%"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" MaxWidth="520" Margin="28,4,28,28">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="EncryptNotice" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,16,0" Visibility="Collapsed"/>
                    <Button x:Name="EncryptButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ui.Encrypt}" MinWidth="112"
                            Click="Encrypt_Click" AutomationProperties.AutomationId="Encrypt"/>
                </Grid>
            </Grid>

            <!-- Unlock -->
            <ScrollViewer x:Name="UnlockView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel MaxWidth="360" Margin="28,0,28,44" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource LockGlyph}" Width="48" Height="48" Foreground="{DynamicResource Ink}" Focusable="False" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PackageName" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" TextOptions.TextFormattingMode="Ideal"/>
                    <TextBlock x:Name="PackageMeta" Style="{StaticResource Meta}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Button x:Name="ReloadButton" Style="{StaticResource LinkButton}" Content="{DynamicResource Ui.Reload}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Visibility="Collapsed" Click="Reload_Click" AutomationProperties.AutomationId="Reload"/>

                    <PasswordBox x:Name="UnlockPassword" Height="44" Margin="0,28,0,0" local:Field.Placeholder="{DynamicResource Ui.UnlockPasswordPlaceholder}"
                                 KeyDown="UnlockPassword_KeyDown" PasswordChanged="UnlockPassword_PasswordChanged"
                                 AutomationProperties.Name="{DynamicResource Ui.UnlockPasswordPlaceholder}" AutomationProperties.AutomationId="UnlockPassword"/>
                    <TextBlock x:Name="UnlockError" Text="{DynamicResource Ui.WrongPassword}" Style="{StaticResource Meta}" Foreground="{DynamicResource Danger}" Margin="2,8,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="UnlockCapsLock" Text="{DynamicResource Ui.CapsLock}" Style="{StaticResource Meta}" Foreground="{DynamicResource Warning}" Margin="2,8,0,0" Visibility="Collapsed"/>

                    <Button x:Name="DecryptButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ui.Decrypt}" Height="40" Margin="0,16,0,0"
                            Click="Decrypt_Click" AutomationProperties.AutomationId="Decrypt"/>
                    <TextBlock x:Name="UnlockNotice" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"/>

                    <Grid Margin="2,26,2,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Ui.RestoreTo}" Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="DestinationText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="{DynamicResource Ui.Change}" FontSize="12" Margin="10,0,0,0"
                                Click="ChooseDestination_Click" AutomationProperties.AutomationId="ChooseDestination"/>
                    </Grid>
                    <CheckBox x:Name="VerifyFirstCheck" Content="{DynamicResource Ui.VerifyFirst}" Margin="2,12,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="VerifyFirst"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Repair -->
            <ScrollViewer x:Name="RepairView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel MaxWidth="420" Margin="28,0,28,44" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Sunken}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="RepairName" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" TextOptions.TextFormattingMode="Ideal"/>
                    <TextBlock x:Name="RepairMeta" Style="{StaticResource Meta}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <Border x:Name="RepairResult" Style="{StaticResource Tile}" Margin="0,26,0,0" Padding="16,14" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="RepairDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,10,0"/>
                                <TextBlock x:Name="RepairStatus" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="RepairSummary" Style="{StaticResource Readout}" Margin="18,6,0,0" MaxHeight="150" AutomationProperties.AutomationId="RepairSummary"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RepairNotice" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>

                    <Button x:Name="RepairAction" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" MinWidth="128" Margin="0,26,0,0"
                            Click="RepairAction_Click" AutomationProperties.AutomationId="RepairAction"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Working -->
            <Grid x:Name="WorkingView" Visibility="Collapsed">
                <StackPanel Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,48">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WorkStage" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="WorkBatch" Style="{StaticResource Meta}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                        <TextBlock x:Name="WorkPercent" Grid.Column="1" FontSize="15" Foreground="{DynamicResource Ink2}" Margin="16,0,0,0" Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                    <ProgressBar x:Name="WorkProgress" Maximum="100" Margin="0,12,0,0" AutomationProperties.Name="{DynamicResource Ui.Progress}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WorkPath" Style="{StaticResource Meta}" TextTrimming="CharacterEllipsis" Text=" "/>
                        <TextBlock x:Name="WorkDetail" Grid.Column="1" Style="{StaticResource Meta}" Margin="16,0,0,0" Typography.NumeralAlignment="Tabular" Text=" "/>
                    </Grid>
                    <Button x:Name="CancelButton" Content="{DynamicResource Ui.Cancel}" HorizontalAlignment="Center" MinWidth="96" Margin="0,40,0,0"
                            Click="Cancel_Click" AutomationProperties.AutomationId="Cancel"/>
                </StackPanel>
            </Grid>

            <!-- Done -->
            <ScrollViewer x:Name="DoneView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel MaxWidth="440" Margin="28,0,28,44" VerticalAlignment="Center">
                    <Grid x:Name="DoneMark" Width="52" Height="52" HorizontalAlignment="Center" RenderTransformOrigin=".5,.5">
                        <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                        <Ellipse Fill="{DynamicResource SuccessSoft}"/>
                        <Path Data="M 17.5,26.5 L 23.5,32.5 L 35,21" Stroke="{DynamicResource Success}" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                    <TextBlock x:Name="DoneTitle" Style="{StaticResource Heading}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <Border Style="{StaticResource Tile}" Padding="0" Margin="0,24,0,0">
                        <StackPanel x:Name="DoneFiles"/>
                    </Border>
                    <TextBlock x:Name="DoneHint" Style="{StaticResource Meta}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock x:Name="DoneWarning" Foreground="{DynamicResource Warning}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                        <Button x:Name="DonePrimary" Style="{StaticResource PrimaryButton}" MinWidth="120" Click="DonePrimary_Click" AutomationProperties.AutomationId="DonePrimary"/>
                        <Button x:Name="DoneSecondary" MinWidth="96" Margin="8,0,0,0" Click="DoneSecondary_Click" AutomationProperties.AutomationId="DoneSecondary"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
